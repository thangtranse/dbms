# OfficeLunch (localhost only)
OFFICE_LUNCH_PORT=3000

# Qdrant
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_LOG_LEVEL=INFO
QDRANT_API_KEY=replace-with-a-long-random-secret

# Teradata Vantage (external database/VM; no official database server image exists)
TERADATA_HOST=100.65.210.21
TERADATA_USER=dbc
TERADATA_PASSWORD=replace-me
TERADATA_LOGMECH=TD2
TERADATA_ENCRYPTDATA=true
TERADATA_LOGON_TIMEOUT=10
TERADATASQL_VERSION=20.0.0.72


# Backend uses existing sandbox services
OFFICE_LUNCH_API_PORT=8001
QDRANT_URL=http://100.65.210.21:6333
QDRANT_PREFIX=officelunch
TERADATA_DATABASE=officelunch
